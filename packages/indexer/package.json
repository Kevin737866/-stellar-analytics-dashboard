{
  "name": "@stellar-analytics/indexer",
  "version": "1.0.0",
  "description": "Stellar blockchain data ingestion service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "dev:start": "ts-node src/index.ts",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "db:migrate": "ts-node src/database/migrate.ts",
    "db:migrate:down": "ts-node src/database/migrate.ts --down",
    "db:migrate:create": "node-pg-migrate create -f .node-pg-migraterc",
    "db:migrate:redo": "node-pg-migrate redo -f .node-pg-migraterc",
    "db:seed": "ts-node src/database/seed.ts",
    "test": "jest --config jest.config.js --testPathIgnorePatterns migrations.test",
    "test:watch": "jest --config jest.config.js --watch --testPathIgnorePatterns migrations.test",
    "test:migrations": "jest --config jest.config.js --testPathPattern migrations.test --runInBand --forceExit"
  },
  "dependencies": {
    "@stellar-analytics/shared": "workspace:*",
    "@stellar/stellar-sdk": "^16.1.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.11.3",
    "redis": "^6.1.0",
    "ws": "^8.21.1",
    "dotenv": "^17.4.2",
    "winston": "^3.11.0",
    "node-cron": "^4.6.0",
    "axios": "^1.6.2",
    "zod": "^4.4.3",
    "prom-client": "^15.1.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "nodemailer": "^9.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.10.9",
    "@types/ws": "^8.5.9",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "ts-node": "^10.9.1",
    "typescript": "^7.0.2",
    "jest": "^30.4.2",
    "@types/jest": "^30.0.0",
    "ts-jest": "^29.4.12"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@stellar-analytics/shared$": "<rootDir>/../shared/src/index.ts"
    }
  }
}
